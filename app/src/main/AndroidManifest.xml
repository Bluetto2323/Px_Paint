<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Vulkan is preferred but NOT required: devices without it use OpenGL ES. -->
    <uses-feature android:name="android.hardware.vulkan.version" android:version="0x400000" android:required="false" />
    <uses-feature android:name="android.hardware.vulkan.level" android:version="0" android:required="false" />
    <!-- OpenGL ES 3.0 is the minimum (0x00030000). -->
    <uses-feature android:glEsVersion="0x00030000" android:required="true" />

    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:hardwareAccelerated="true"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">

        <!-- configChanges: rotation / resizing only resize the surface; the
             activity (and the GPU device) are not recreated. -->
        <activity
            android:name=".app.MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|density|uiMode"
            android:resizeableActivity="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
