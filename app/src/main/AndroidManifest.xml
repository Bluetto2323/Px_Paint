<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Vulkan is preferred but NOT required: devices without it use OpenGL ES. -->
    <uses-feature android:name="android.hardware.vulkan.version" android:version="0x400000" android:required="false" />
    <uses-feature android:name="android.hardware.vulkan.level" android:version="0" android:required="false" />
    <!-- OpenGL ES 3.0 is the minimum (0x00030000). -->
    <uses-feature android:glEsVersion="0x00030000" android:required="true" />

    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:hardwareAccelerated="true"
        android:theme="@style/Theme.PxPaint">

        <!-- PxPaint (launcher). configChanges: rotation / resizing / theme
             only resize the surface and rebuild the chrome; the activity
             and the GPU device are not recreated. -->
        <activity
            android:name=".pxpaint.PxPaintActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|navigation|density|uiMode|locale|layoutDirection|fontScale"
            android:windowSoftInputMode="adjustResize"
            android:resizeableActivity="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Block 1 engine diagnostics (DEVICE TEST / REPORT), opened from
             PxPaint settings. Separate process: the native Vulkan loader
             state is process-global, so it gets its own engine instance.
             Exported (no launcher entry) so it can also be started with
             adb shell am start -n com.paintengine/.app.DiagnosticsActivity -->
        <activity
            android:name=".app.DiagnosticsActivity"
            android:label="@string/diagnostics_name"
            android:process=":diagnostics"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|density|uiMode"
            android:resizeableActivity="true" />
    </application>
</manifest>
