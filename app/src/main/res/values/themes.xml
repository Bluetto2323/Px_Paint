<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark window background so a cold start never flashes white; the
         activity draws edge-to-edge and applies its own (dark/light) theme. -->
    <style name="Theme.PxPaint" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/px_bg</item>
        <item name="android:colorBackground">@color/px_bg</item>
        <item name="android:colorAccent">@color/px_ember</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
